{
  "manifest_version": 3,
  "name": "Session Workspace",
  "version": "0.4.0",
  "description": "Личный зашифрованный архив браузерных сессий с переключателями сервисов.",
  "permissions": ["tabs", "cookies", "storage", "permissions"],
  "host_permissions": [
    "https://ipdqgqqlfbpucxchmmtf.supabase.co/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "https://*.google.com/*",
    "https://google.com/*",
    "https://*.vk.com/*",
    "https://vk.com/*",
    "https://*.mirea.ru/*",
    "https://mirea.ru/*"
  ],
  "action": {
    "default_title": "Session Workspace",
    "default_popup": "popup.html"
  }
}
