# --- PostgreSQL ---
POSTGRES_DB=session_workspace
POSTGRES_USER=session_admin
POSTGRES_PASSWORD=__GENERATE_WITH__openssl_rand_hex_32__

# --- Session Workspace API ---
# Domain that points to your VPS (A/AAAA record)
DOMAIN=vault.example.com

# Invite code for closed pilot registration (generate a long random string)
REGISTRATION_INVITE_CODE=__GENERATE_WITH__openssl_rand_hex_32__

# Comma-separated list of allowed extension origins
# Format: chrome-extension://<EXTENSION_ID>
# Find the ID on chrome://extensions after loading the unpacked extension
ALLOWED_ORIGINS=chrome-extension://abcdefghijklmnopqrstuvwxyzabcdef
